# ========================================================
# CyberShield - Distributed Cyberattack Detection System
# Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Default connects to local MongoDB; if unreachable, automatically falls back to MongoMemoryServer
MONGO_URI=mongodb://127.0.0.1:27017/cybershield

# Distributed Message Queue (Redis Streams & Pub/Sub)
# Default connects to local Redis; if unreachable, automatically falls back to Embedded Stream Broker
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security Secrets
JWT_SECRET=cybershield_super_secret_jwt_key_2026_soc_enterprise
JWT_EXPIRES_IN=24h
AGENT_SHARED_SECRET=cybershield-agent-key-secret-999

# Node Management
NODE_HEARTBEAT_TIMEOUT_MS=30000

# Machine Learning Anomaly Detection Microservice
ML_SERVICE_URL=http://127.0.0.1:5001
